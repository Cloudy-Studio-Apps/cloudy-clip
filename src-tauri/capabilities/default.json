{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://fonts.google.com/*" },
        { "url": "https://fonts.googleapis.com/*" },
        { "url": "https://fonts.gstatic.com/*" }
      ]
    },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$APPDATA/fonts/**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$APPDATA/fonts/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPDATA/fonts/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$APPDATA/fonts/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPDATA/fonts/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPDATA/fonts/**" }] }
  ]
}
